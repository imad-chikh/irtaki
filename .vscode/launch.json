  "version": "0.2.0",
  "configurations": [
    {
      "name": "irtaki",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "irtaki (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "irtaki (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    },
    {
      "name": "irtaki (Whisper backend)",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define=WHISPER_API_BASE_URL=http://192.168.100.26:8000"
      ]
    },
    {
      "name": "irtaki (Whisper backend ngrok)",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define=WHISPER_API_BASE_URL=https://itsimad-irtaki-quran-whisper.hf.space"
      ]
    }
  ]
}
